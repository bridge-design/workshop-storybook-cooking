{
  "name": "super-design-system",
  "version": "1.17.3",
  "description": "A demo design system to showcase integrations and customizations of Storybook",
  "main": "./dist/super-design-system.umd.js",
  "module": "./dist/super-design-system.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/super-design-system.es.js",
      "require": "./dist/super-design-system.umd.js"
    },
    "./styles.css": "./dist/super-design-system.css"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run product",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:unit": "TEST_MODE=unit vitest",
    "test:unit:ui": "TEST_MODE=unit vitest --ui",
    "test:ui": "vitest --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm rebuild --include=optional && storybook build",
    "product": "next dev",
    "build-product": "next build"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "next": "^15.1.0",
    "playwright": "^1.56.0",
    "storybook": "^10.6.0",
    "storybook-addon-tag-badges": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4",
    "@storybook/addon-mcp": "^10.6.0"
  }
}
